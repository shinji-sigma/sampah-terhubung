NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Required for validated photo upload and seed scripts. Never use NEXT_PUBLIC.
# New sb_secret_... key or legacy service_role key. Fill exactly one.
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Use true only for a dedicated simulation project, including the second laptop.
DEMO_MODE=true
APP_ORIGIN=http://localhost:3000
# Used only by demo:seed / test:integration. Set your own password (12+ characters).
DEMO_PASSWORD=
# Enable quick-fill demo credentials on login screen (presentation only)
DEMO_LOGIN_ENABLED=false
